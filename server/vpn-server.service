[Unit]
Description=VPN Server (TUN + UDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd 服务模板：由 sudo ./start.sh install 自动生成 /etc/systemd/system/vpn-server.service
# 占位符 __SCRIPT_DIR__（脚本所在目录）、__LOGS_DIR__（日志目录）会被自动替换为实际路径，无需手写
ExecStartPre=/bin/mkdir -p __LOGS_DIR__
ExecStart=__SCRIPT_DIR__/start.sh start
Restart=on-failure
RestartSec=3
# 需要网络管理能力（创建 TUN）
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

# 运行日志：重点日志写入 logs/systemd.log；也可 journalctl -u vpn-server -f 查看
StandardOutput=append:__LOGS_DIR__/systemd.log
StandardError=append:__LOGS_DIR__/systemd.log

[Install]
WantedBy=multi-user.target
