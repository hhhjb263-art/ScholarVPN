
QWidget {
    background-color: #f5f6fa;
    color: #2d3436;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    margin: 2px;
}

QFrame#serverCard {
    background-color: #cccccc;
    border: 1px solid #444444;
    border-radius: 8px;
}
QPushButton {
    background-color: #cccccc;
    border: 1px solid #999999;
    border-radius: 4px;
    padding: 4px 10px;
}